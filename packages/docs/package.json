{
  "name": "@ferment-ui/docs",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "wireit",
    "build": "wireit",
    "preview": "astro preview",
    "astro": "astro"
  },
  "wireit": {
    "dev": {
      "command": "astro dev",
      "service": true,
      "dependencies": [
        "../core:build"
      ]
    },
    "build": {
      "command": "astro build",
      "output": [
        "build"
      ]
    }
  },
  "dependencies": {
    "@astrojs/svelte": "^7.1.1",
    "astro": "^5.6.1",
    "sharp": "^0.34.2",
    "svelte": "^5.39.4",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "wireit": "^0.14.12"
  }
}