---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Elements - Ferment UI">
  <main>
  <h1>Elements</h1>
    <div class='prose'>
      <details>
        <summary><h3>Anchor</h3></summary>
        <ul role="list">
          <li><a href='#'>Internal Link</a></li>
          <li><a href='https://google.com'>External Link</a></li>
        </ul>
      </details>
      
      <details>
        <summary><h3>Button</h3></summary>
        <button>Content</button>
      </details>

      <details>
        <summary><h3>Caption</h3></summary>
        <caption>Content</caption>
      </details>

      <details>
        <summary><h3>Code</h3></summary>
        <code>Content</code>
      </details>

      <details>
        <summary><h3>Dialog</h3></summary>
        <dialog>Content</dialog>
      </details>

      <details>
        <summary><h3>Figure</h3></summary>
        <figure>Content</figure>
      </details>
      <details>
        <summary><h3>HR</h3></summary>
        <hr />
      </details>
      <details>
        <summary><h3>Image</h3></summary>
        <img src='https://placehold.co/600x400' alt='random image' />
      </details>

      <details>
        <summary><h3>List</h3></summary>
        <h4>Ordered</h4>
        <ol>${[1, 2, 3].map(item => /*html*/`<li>${item}</li>`).join('')}</ol>
        <h4>Unordered ([role="list"])</h4>
        <ul role="list">${[1, 2, 3].map(item => /*html*/`<li>${item}</li>`).join('')}</ul>
        <h4>Presentational (no [role="list"]</h4>
        <ul>${[1, 2, 3].map(item => /*html*/`<li>${item}</li>`).join('')}</ul>
      </details>
      <details>
        <summary><h3>Mark</h3></summary>
        <mark>Content</mark>
      </details>
      <details>
        <summary><h3>Meter</h3></summary>
        <meter></meter>
      </details>
      <details>
        <summary><h3>Picture</h3></summary>
        <picture>
          <source srcset='https://placehold.co/600x400' type='image/jpeg'>
          <img src='https://placehold.co/600x400' alt='random image' />
        </picture>
      </details>
      <details>
        <summary><h3>Progress</h3></summary>
        <progress></progress>
      </details>
      <details>
        <summary><h3>Table</h3></summary>
      </details>
    </div>
  </main>
</Layout>