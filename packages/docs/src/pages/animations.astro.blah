---
import Layout from '../layouts/Layout.astro'
---

<Layout title='Layout'>
  <div class='stagger-delay' style='--stagger: 5s'>
    <h1 class='intro'>Animations</h1>
    <p class='intro'>Animations are a great way to add some life to your website. Astro supports CSS animations and transitions out of the box. You can use the <code>style</code> attribute to add inline styles to your elements and animate them using CSS.</p>
  </div>
</Layout>