---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Patterns - Ferment UI">
  <main>
    <h1>Patterns</h1>
    <p>Reusable UI patterns and component-like styles for common interface elements.</p>
    
    <section>
      <h2>Navigation Patterns</h2>
      <p>Menu, breadcrumb, and navigation pattern styles will be documented here.</p>
    </section>
    
    <section>
      <h2>Layout Patterns</h2>
      <p>Card, hero, banner, and layout pattern styles will be shown here.</p>
    </section>
    
    <section>
      <h2>Interactive Patterns</h2>
      <p>Accordion, tabs, modal, and interactive pattern styles will be documented here.</p>
    </section>
    
    <section>
      <h2>Feedback Patterns</h2>
      <p>Alert, tooltip, badge, and feedback pattern styles will be listed here.</p>
    </section>
  </main>
</Layout>