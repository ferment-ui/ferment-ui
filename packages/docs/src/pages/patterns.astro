---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Patterns - Ferment UI">
  <main>
<h1>Patterns</h1>
    <div class='prose'>
      <details>
        <summary><h3>Accordion</h3></summary>
        ${accordion(null, /*html*/`
          <details name='accordion'>
            <summary>One</summary>
            thing
          </details>
          <details name='accordion'>
            <summary>Another</summary>
            thing
          </details>
        `)}
      </details>
      <details>
        <summary><h3>Alert</h3></summary>
        <div class='prose'>
          ${['info', 'warn', 'success'].map(variant => alert(null, /*html*/`<h4>${`${variant.charAt(0).toUpperCase()}${variant.slice(1)}`}!</h4><p>Content</p>`, { class: variant })).join('')}
        </div>
      </details>
      <details>
        <summary><h3>Badge</h3></summary>
        <span class="badge something" style="zIndex: 2;" disabled>Hello!</span>
        ${badge({ class: 'something', style: { zIndex: '2' }, disabled: true }, 'Hello!')}
      </details>
      <details>
        <summary><h3>Banner</h3></summary>
        <div class="banner">Banner content</div>
      </details>

      <details>
        <summary><h3>Blockquote</h3></summary>
        <figure>
          <blockquote>
            <p>This is a blockquote.</p>
          </blockquote>
          <figcaption>— Author</figcaption>
        </figure>
      </details>

      <details>
        <summary><h3>Breadcrumbs</h3></summary>
        <nav class="breadcrumbs">
          <a href="#">Home</a>
          <span aria-current="page">Current Page</span>
        </nav>
      </details>
      <details>
        <summary><h3>Card</h3></summary>
        <div class="card">
          <h4>Card Title</h4>
          <p>Card content goes here.</p>
        </div>
      </details>
      <details>
        <summary><h3>Carousel</h3></summary>
        <div class="carousel">
          <div class="carousel-item">Item 1</div>
          <div class="carousel-item">Item 2</div>
          <div class="carousel-item">Item 3</div>
        </div>
      </details>
      <details>
        <summary><h3>Combobox</h3></summary>
        <div class="combobox">
          <input type="text" placeholder="Select or type..." />
          <ul class="options">
            <li>Option 1</li>
            <li>Option 2</li>
            <li>Option 3</li>
          </ul>
        </div>
      </details>
      <details>
        <summary><h3>Comment</h3></summary>
        <div class="comment">
          <p><strong>User:</strong> This is a comment.</p>
          <p><strong>Reply:</strong> This is a reply to the comment.</p>
        </div>
      </details>
      <details>
        <summary><h3>Content Info</h3></summary>
        <div class="content-info">
          <h4>Content Info Title</h4>
          <p>Some information about the content.</p>
        </div>
      </details>
      <details>
        <summary><h3>Feed</h3></summary>
        <div class="feed">
          <article class="feed-item">
            <h4>Feed Item Title</h4>
            <p>Feed item content goes here.</p>
          </article>
          <article class="feed-item">
            <h4>Another Feed Item</h4>
            <p>More content for the feed.</p>
          </article>
        </div>
      </details>
      <details>
        <summary><h3>Hero</h3></summary>
        <div class="hero">
          <h1>Hero Section</h1>
          <p>Hero content goes here.</p>
        </div>
      </details>
      <details>
        <summary><h3>Icon</h3></summary>
        <div class="icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="2"/>
          </svg>
        </div>
      </details>
      <details>
        <summary><h3>Lightbox</h3></summary>
        <div class="lightbox">
          <img src="https://placehold.co/600x400" alt="Lightbox Image" />
        </div>
      </details>
      <details>
        <summary><h3>Likes</h3></summary>
        <div class="likes">
          <button class="like-button">Like</button>
          <span class="like-count">10 Likes</span>
        </div>
      </details>
      <details>
        <summary><h3>Listbox</h3></summary>
        <div class="listbox">
          <select>
            <option value="1">Option 1</option>
            <option value="2">Option 2</option>
            <option value="3">Option 3</option>
          </select>
        </div>
      </details>
      <details>
        <summary><h3>Menu</h3></summary>
        <ul class="menu">
          <li><a href="#">Menu Item 1</a></li>
          <li><a href="#">Menu Item 2</a></li>
          <li><a href="#">Menu Item 3</a></li>
        </ul>
      </details>
      <details>
        <summary><h3>Menubar</h3></summary>
        <div class="menubar">
          <button>File</button>
          <button>Edit</button>
          <button>View</button>
        </div>
      </details>
      <details>
        <summary><h3>Rating</h3></summary>
        <div class="rating">
          <span class="star">★</span>
          <span class="star">★</span>
          <span class="star">★</span>
          <span class="star">☆</span>
          <span class="star">☆</span>
        </div>
      </details>
      <details>
        <summary><h3>Searchbox</h3></summary>
        <div class="searchbox">
          <input type="search" placeholder="Search..." />
        </div>
      </details>
      <details>
        <summary><h3>Slider</h3></summary>
        <div class="slider">
          <input type="range" min="0" max="100" />
        </div>
      </details>
      <details>
        <summary><h3>Spinbutton</h3></summary>
        <div class="spinbutton">
          <button>-</button>
          <input type="number" min="0" max="100" />
          <button>+</button>
        </div>
      </details>
      <details>
        <summary><h3>Splitter</h3></summary>
        ${splitter(null, [
          /*html*/`<div class="pane">Left Pane</div>`,
          /*html*/`<div class="pane">Right Pane</div>`
        ])}
      </details>
      <details>
        <summary><h3>Tabs</h3></summary>
        <div class="tabs">
          TODO
        </div>
      </details>
      <details>
        <summary><h3>Toolbar</h3></summary>
        <div class="toolbar">
          <button>Bold</button>
          <button>Italic</button>
          <button>Underline</button>
        </div>
      </details>
      <details>
        <summary><h3>Tooltip</h3></summary>
        <div class="tooltip">
          <button>Hover me</button>
          <span class="tooltip-text">Tooltip content</span>
        </div>
      </details>
      <details>
        <summary><h3>Tree</h3></summary>
        <ul class="tree">
          <li>
            <span>Node 1</span>
            <ul>
              <li>Child 1</li>
              <li>Child 2</li>
            </ul>
          </li>
          <li>
            <span>Node 2</span>
            <ul>
              <li>Child 1</li>
              <li>Child 2</li>
            </ul>
          </li>
        </ul>
      </details>
    </div>
  </main>
</Layout>