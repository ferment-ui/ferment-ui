---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Groups - Ferment UI">
  <main>
<h1>Forms</h1>
    <form class='prose'>
      ${checkbox(null, 'Checkbox', { inputAttrs: { id: 'checkbox1', checked: true } })}
      ${text(null, 'Text Input', { inputAttrs: { placeholder: 'Type here...', pattern: '[a-z]', required: true } })}
      ${password(null, 'Password Input', { inputAttrs: { id: 'password1' } })}
      ${radiogroup(null, 'Radio Group', { name: 'group1', radios: [
        { id: 'radio1', children: 'Option 1' },
        { id: 'radio2', children: 'Option 2' },
        { id: 'radio3', children: 'Option 3' }
      ]})}
    </form>
  </main>
</Layout>