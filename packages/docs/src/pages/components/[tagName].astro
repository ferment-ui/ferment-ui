---
import Layout from '../../layouts/Layout.astro';
import customElementsManifest from 'ferment-ui/custom-elements.json';

export async function getStaticPaths() {
  return customElementsManifest.modules.filter(module => module.declarations.length && (module.declarations[0] as any).tagName != undefined)
  .map((tag) => {
    const { tagName, members } = tag.declarations[0] as unknown as { tagName: string, members: any };
    console.log(tagName);
    return {
      params: {
        tagName: tagName.replace('fui-', ''),
      },
      props: {
        members
      },
    };
  });
}

const { tagName } = Astro.params;
const { members } = Astro.props;
const fields = members.filter((member: any) => member.kind === 'field');
const methods = members.filter((member: any) => member.kind === 'method');
const events = members.filter((member: any) => member.kind === 'event');
const slots = members.filter((member: any) => member.kind === 'slot');
const cssVariables = members.filter((member: any) => member.kind === 'cssvar');
const cssProps = members.filter((member: any) => member.kind === 'cssprop');
const cssParts = members.filter((member: any) => member.kind === 'csspart');
---

<Layout title={tagName}>
  <h2>{tagName}</h2>
  <h3>Fields</h3>
  <ul>
    {fields.map((field: any) => (
       <li>
        <h4>{field.name}</h4>
        <p>{field.type}</p>
        <p>{field.description}</p>
        <p>{JSON.stringify(field)}</p>
      </li>
    ))}
  </ul>
  <h3>Methods</h3>
  <ul>
    {methods.map((method: any) => (
      <li>
        <h4>{method.name}</h4>
        <p>{method.description}</p>
      </li>
    ))}
</Layout>