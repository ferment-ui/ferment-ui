---
// import { getCustomElements } from '../utils/custom-elements.js';
import 'ferment-ui/fui.css';

interface Props {
	title: string;
  frontmatter?: {
    title: string;
  };
}

const { title } = Astro.props.frontmatter || Astro.props;

---

<!doctype html>
<html lang="en" class='no-js'>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Ferment UI | {title}</title>
		<meta name="description" content="Astro description" />
    <!-- <script type="module">document.documentElement.classList.toggle('no-js')</script> -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script>
      import '../../../core/src/index.js';
    </script>
	</head>
	<body class="row">
    <aside>
      <h1>Ferment UI</h1>
      <nav class="column">
        <details open>
          <summary>Getting Started</summary>
          <ul>
            <li>
              <a href="/getting-started/installation">Installation</a>
            </li>
            <li>
              <a href="/getting-started/usage">Usage</a>
            </li>
          </ul>
        </details>
        <details open>
          <summary>CSS</summary>
          <ul>
            <li>
              <a href="/css/overview">Overview</a>
            </li>
            <!-- {Object.keys(getCss()).map((css) => (
              <li>
                <a href={`/css/${css}`}>{css}</a>
              </li>
            ))} -->
          </ul>
        </details>
        <details open>
          <summary>Components</summary>
          <ul>
            <!-- {getCustomElements().map((element) => (
              <li>
                <a href={`/components/${element.name?.toLowerCase()}`}>{element.name}</a>
              </li>
            ))} -->
          </ul>
        </details>
      </nav>
    </aside>
    <main class="p">
      <slot />
    </main>
    <!-- <script>
      const entries = document.querySelectorAll('.intro');
      const introObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          entry.target.classList.toggle('introed');
          entry.target.classList.remove('intro');
        });
      });
      entries.forEach((entry) => {
        introObserver.observe(entry);
      });
    </script> -->
	</body>
</html>