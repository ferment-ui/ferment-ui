---
import type { ComponentProps } from 'astro/types';
import Site from '@ferment-ui/astro/layouts/Site.astro';
import Banner from '@ferment-ui/astro/components/Banner.astro';

type Props = ComponentProps<typeof Site> & {}

const { title, description, bodyClasses, mainClasses, seo } = Astro.props;
---

<Site 
  title={title} 
  description={description}
  bodyAttributes={bodyClasses}
  mainClasses={mainClasses}
  seo={seo}
>
  <Banner slot='banner' role='banner'>
    <nav>
      <ul>
        <li><a href='/animations'>Animations</a></li>
      </ul>
    </nav>
  </Banner>
  <slot />
</Site>