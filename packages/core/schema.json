{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ferment UI",
  "description": "Schema for the Ferment UI theme configuration files",
  "type": "object",
  "properties": {
    "spacing": {
      "type": "object",
      "properties": {
        "base": {
          "type": "integer",
          "default": 6
        },
        "pageWidth": {
          "type": "string",
          "default": "50ch"
        },
        "flow": {
          "type": "string",
          "default": "calc(var(--fui-spacing-base) * 3)"
        },
        "min": {
          "type": "string",
          "default": "calc(var(--fui-spacing-base) * 3)"
        }
      }
    },
    "swatches": {
      "type": "object",
      "$ref": "#/$defs/swatch",
      "default": {
        "gray": {
          "1": "hsl(0, 0%, 98%)"
        },
        "blue": {
          "1": "hsl(210, 100%, 98%)"
        },
        "green": {
          "1": "hsl(120, 100%, 98%)"
        },
        "red": {
          "1": "hsl(0, 100%, 98%)"
        },
        "yellow": {
          "1": "hsl(60, 100%, 98%)"
        }
      }
    },
    "themes": {
      "type": "object",
      "properties": {
        "light": {
          "$ref": "#/$defs/theme"
        },
        "dark": {
          "$ref": "#/$defs/theme"
        }
      }
    },
    "typography": {
      "properties": {
        "fontFaces": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/fontFace"
          }
        },
        "scale": {
          "type": "number",
          "enum": ["1.067", "1.200", "1.250", "1.309", "1.333", "1.414", "1.500", "1.618"]
        },
        "body": {
          "$ref": "#/$defs/font",
          "default": {
            "family": "system-ui, sans-serif",
            "size": "1rem",
            "lineHeight": "1.5",
            "weight": "400",
            "style": "normal",
            "decoration": "none",
            "transform": "none",
            "letterSpacing": "normal",
            "shadow": "none"
          }
        },
        "heading": {
          "$ref": "#/$defs/font",
          "default": {
            "family": "system-ui, serif",
            "size": "2rem",
            "lineHeight": "1.5",
            "weight": "700",
            "style": "normal",
            "decoration": "none",
            "transform": "none",
            "letterSpacing": "normal",
            "shadow": "none"
          }
        },
        "subheading": {
          "$ref": "#/$defs/font"
        },
        "pullQuote": {
          "$ref": "#/$defs/font"
        },
        "h1": {
          "$ref": "#/$defs/font"
        },
        "h2": {
          "$ref": "#/$defs/font"
        },
        "h3": {
          "$ref": "#/$defs/font"
        },
        "h4": {
          "$ref": "#/$defs/font"
        },
        "h5": {
          "$ref": "#/$defs/font"
        },
        "h6": {
          "$ref": "#/$defs/font"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/font"
      }
    },
    "layers": {
      "type": "object"
    },
    "shadows": {
      "type": "object",
      "properties": {
        "0": {
          "type": "string"
        },
        "1": {
          "type": "string"
        },
        "2": {
          "type": "string"
        },
        "3": {
          "type": "string"
        },
        "4": {
          "type": "string"
        },
        "5": {
          "type": "string"
        },
        "6": {
          "type": "string"
        }
      },
      "minLength": 6,
      "maxLength": 6
    },
    "borders": {
      "type": "object",
      "properties": {
        "radius": {
          "type": "string"
        },
        "style": {
          "type": "string"
        }
      }
    },
    "breakpoints": {
      "type": "object",
      "properties": {
        "xsmall": {
          "type": "string"
        },
        "small": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        },
        "large": {
          "type": "string"
        },
        "xlarge": {
          "type": "string"
        }
      }
    },
    "timing": {
      "type": "object",
      "properties": {
        "xslow": {
          "type": "string"
        },
        "slow": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        },
        "fast": {
          "type": "string"
        },
        "xfast": {
          "type": "string"
        },
        "defaults": {
          "type": "object",
          "properties": {
            "speed": {
              "type": "string"
            },
            "in": {
              "type": "string"
            },
            "out": {
              "type": "string"
            },
            "inout": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "theme": {
      "type": "object",
      "properties": {

      }
    },
    "swatch": {
      "type": "object",
      "description": "A collection of hues of a single color, must be in HSLa format",
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "pattern": "hsla?\\(\\d{1,3},\\s\\d{1,3}%,\\s\\d{1,3}%,\\s?\\d?\\.?\\d?\\)"
      }
    },
    "font": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "lineHeight": {
          "type": "string"
        },
        "weight": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "decoration": {
          "type": "string"
        },
        "transform": {
          "type": "string"
        },
        "letterSpacing": {
          "type": "string"
        },
        "shadow": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "fontFace": {
      "type": "object",
      "properties": {
        "ascentOverride": {
          "type": "number"
        },
        "descentOverride": {
          "type": "number"
        },
        "display": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "featureSettings": {
          "type": "string"
        },
        "lineGapOverride": {
          "type": "number"
        },
        "stretch": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "unicodeRange": {
          "type": "string"
        },
        "weight": {
          "type": "string"
        }
      },
      "required": ["family"],
      "additionalProperties": false
    }
  }
}