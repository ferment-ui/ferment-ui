{
  "name": "core",
  "version": "1.0.0",
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "wireit",
    "build:css": "wireit",
    "bundle": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "build:css"
      ]
    },
    "build:css": {
      "command": "node ./lib/build-css.ts",
      "files": [
        "src",
        "lib/build-css.ts",
        "package.json"
      ],
      "output": [
        "dist"
      ]
    },
    "bundle": {
      "command": "node ./lib/bundle-css.ts",
      "env": {
        "NODE_ENV": "production"
      }
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "debug": "^4.4.3",
    "lodash-es": "^4.17.21",
    "ttls-helpers": "^1.1.6"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/lodash-es": "^4.17.12",
    "lightningcss": "^1.30.1",
    "wireit": "^0.14.12"
  }
}
