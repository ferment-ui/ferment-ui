---
import type { HTMLTag, Polymorphic } from 'astro/types';
import { Image } from 'astro:assets';

type Props<Tag extends HTMLTag> = Polymorphic<{
  as: Tag;
  imageAttributes?: typeof Image;
  header: string;
  content: string;
  footer: string;
}>;

const { as: Tag, imageAttributes, header, content, footer, class: cls, style } = Astro.props;
---

<Tag class:list={['card', cls]} style={style}>
  <slot name='card__image'>{imageAttributes && (<Image {...imageAttributes} />)}</slot>
  <slot name='card__header'>{header}</slot>
  <slot name='card__body'>{content}</slot>
  <slot name='card__footer'>{footer}</slot>
</Tag>