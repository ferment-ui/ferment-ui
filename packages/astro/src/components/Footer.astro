---
interface Props {
  companyLegalName: string;
}

const { companyLegalName } = Astro.props;
---

<footer role='footer'>
  <slot />
  <div>
    <p>&copy; {companyLegalName}, <span class='current-year'>{new Date().getFullYear()}</span></p>
    <p>Made with &hearts; by Monad Media</p>
  </div>
</footer>
<script>
  const currentYear = document.querySelector('.current-year');
  currentYear && (currentYear.textContent = new Date().getFullYear().toString());
</script>

