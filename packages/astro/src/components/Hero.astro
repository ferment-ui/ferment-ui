---
import type { HTMLAttributes, HTMLTag, Polymorphic } from 'astro/types';
import type { Source } from './Picture.astro';
import { Image } from 'astro:assets';
import Picture from './Picture.astro';

type Props<Tag extends HTMLTag> = Polymorphic<{
  as: Tag;
  pictureAttributes: typeof Picture;
  sources: Source[];
  imageAttributes?: HTMLAttributes<'img'>;
}>;

const { as: Tag, pictureAttributes, class: cls, sources, imageAttributes, ...attrs } = Astro.props;
---

<Tag class:list={['hero', cls]} {...attrs}>
  <Picture sources={sources} pictureAttributes={pictureAttributes}>
    <slot name='fallback'><Image {...imageAttributes} /></slot>
  </Picture>
  <slot></slot>
</Tag>