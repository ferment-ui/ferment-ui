---
import { FUIPanel } from 'ferment-ui';
---

<header role='banner'>
  <a id='skip-link' href='#main'>Skip to main content</a>
  <FUIPanel client:load>
    <slot />
  </FUIPanel>
</header>
<style>
  #skip-link {
    position: fixed;
    top: 1em;
    left: 50%;
    transform: translateX(-50%);
  }

  #skip-link:not(:focus) {
    border: 0;
    clip: rect(0 0 0 0);
    height: auto;
    margin: 0;
    overflow: hidden;
    padding: 0;
    position: absolute;
    width: 1px;
    white-space: nowrap;
  }
</style>
